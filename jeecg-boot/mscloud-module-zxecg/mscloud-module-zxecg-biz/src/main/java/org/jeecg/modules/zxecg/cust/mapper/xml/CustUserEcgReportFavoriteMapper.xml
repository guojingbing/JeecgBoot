<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.zxecg.cust.mapper.CustUserEcgReportFavoriteMapper">
    <select id="getByRepIdAndUserId" parameterType="java.util.HashMap"
            resultType="org.jeecg.modules.zxecg.cust.entity.CustUserEcgReportFavorite">
     select *  from cust_user_ecg_report_favorite where rep_id=#{repId} and user_id=#{userId}
    </select>
    <delete id="deleteByRepId" parameterType="java.lang.Long">
        delete from cust_user_ecg_report_favorite where rep_id=#{repId}
    </delete>
</mapper>