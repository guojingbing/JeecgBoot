<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.zxecg.cust.mapper.CustUserEcgReportStatisticsMapper">
    <delete id="deleteByRepId" parameterType="java.lang.Long">
        delete from cust_user_ecg_report_statistics where rep_id=#{repId}
    </delete>

    <select id="getByRepId" resultType="org.jeecg.modules.zxecg.cust.entity.CustUserEcgReportStatistics">
        select * from cust_user_ecg_report_statistics where rep_id=#{repId}
    </select>
</mapper>